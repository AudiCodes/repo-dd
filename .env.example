# Solana RPC + parsed history (free developer tier works): https://dashboard.helius.dev
HELIUS_API_KEY=
# X search and profiles, ~$0.0002 per item: https://socialdata.tools
SOCIALDATA_API_KEY=
# EVM wallet history on Ethereum and Robinhood Chain (free tier): https://etherscan.io/apis
ETHERSCAN_API_KEY=
# Optional. X API pay-per-use, used by xcheck.py and wallet_claim.py: https://developer.x.com
X_BEARER_TOKEN=
# Optional. devwatch.py push alerts to ntfy.sh/<topic> while it watches a token
NTFY_TOPIC=
